/// Arsip immutable setiap percobaan kirim mandiri. `LaporanMandiri` tetap
/// proyeksi antrean/status terbaru yang dipakai UI dan proses verifikasi.
model KirimanLaporanMandiri {
  id               String   @id @default(cuid())
  laporanMandiriId String
  pengirimId       String?
  standDilaporkan  Int
  fotoUrl          String
  fotoPublicId     String   @unique
  nomorPelapor     String
  namaPelapor      String
  diterimaPada     DateTime @default(now())

  laporanMandiri LaporanMandiri @relation(fields: [laporanMandiriId], references: [id], onDelete: Restrict)
  pengirim       User?          @relation("KirimanLaporanMandiriPengirim", fields: [pengirimId], references: [id], onDelete: Restrict)

  @@index([laporanMandiriId, diterimaPada])
  @@index([pengirimId, diterimaPada])
  @@map("kiriman_laporan_mandiri")
}

