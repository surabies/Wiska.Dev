{
  "name": "azkaqueen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "turbo dev --ui=stream",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "mobile": "pnpm --filter mobile start",
    "mobile:web": "pnpm --filter mobile web",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:ios": "pnpm --filter mobile ios",
    "db:seed": "pnpm --filter web db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed:mobile": "pnpm --filter web db:seed:mobile"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.4.4"
  }
}
